import java.util.HashMap;

class Solution {
    public int[] twoSum(int[] nums, int target) {
        
        HashMap<Integer, Integer> notebook = new HashMap<>();

        for (int i = 0; i < nums.length; i++) {
            int currentNum = nums[i];
            int neededNum = target - currentNum; 

            
            if (notebook.containsKey(neededNum)) {
               
                return new int[] { notebook.get(neededNum), i };
            }

            
            notebook.put(currentNum, i);
        }
        
        return new int[] {};
    }
}
