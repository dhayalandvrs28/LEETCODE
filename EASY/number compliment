class Solution {
    public int findComplement(int num) {

        int mask = 0;
        int temp = num;

        // Create mask with same number of bits as num
        while (temp > 0) {
            mask = (mask << 1) | 1;
            temp = temp >> 1;
        }

        // Flip only the required bits
        return num ^ mask;
    }
}
